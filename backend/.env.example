# HIACDI backend environment
# Copy this file to .env and fill in real values. Never commit .env.

# Required in production
NODE_ENV=production
ADMIN_EMAIL=admin@hiacdi.org
ADMIN_NAME=HIACDI Admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Optional reusable token that unlocks admin sign-in after 4 wrong passwords
ADMIN_UNLOCK_TOKEN=
SESSION_SECRET=change-this-to-a-random-string-of-at-least-32-characters
JWT_SECRET=

# Public URL of the deployed site, used for CORS and links in emails
FRONTEND_URL=https://hiacdi.org

# Base URL used in certificate verification email links (QR scan links)
PUBLIC_URL=https://hiacdi.org

# Port the API listens on (your host may inject its own PORT)
PORT=5000

# Database. Leave unset to use local file storage (development).
# For hosting, create a free MongoDB Atlas cluster and paste its connection string.
MONGO_URI=
ALLOW_REMOTE_MONGO=true

# Email (Nodemailer SMTP). Needed for application confirmations and broadcasts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HIACDI Tech Hub <hiacditechhub@gmail.com>

# Optional: hosted URL for the logo in email headers. By default the logo is
# embedded directly into each email from backend/assets/logo-email.png.
# EMAIL_LOGO_URL=https://hiacdi.org/brand/logo-email.png

# Google sign-in for students (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (admin file uploads). Copy API keys from the Cloudinary dashboard.
# Either set the three values below, or paste the single CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLIENT_URL=https://hiacdi.org
JWT_SECRET=
